{
  "format_version": 1,
  "source": "Synthetic fixtures derived from selected Gitcrawl regression cases.",
  "truth_table": "fixtures/scenarios/observation_ordering.json",
  "required_invariants": [
    "delayed_observations",
    "failure_isolation",
    "closed_sweep_offline_coverage",
    "partial_sync_retains_work",
    "comment_reuse",
    "review_membership_restore",
    "deterministic_cluster_scoring"
  ],
  "fixtures": [
    "fixtures/github/repository.json",
    "fixtures/github/issue.json",
    "fixtures/github/pull_request.json",
    "fixtures/github/comments_complete.json",
    "fixtures/github/comments_complete_empty.json",
    "fixtures/github/comments_page_1.json",
    "fixtures/github/comments_page_2.json",
    "fixtures/github/pull_reviews.json",
    "fixtures/github/rate_limit_429.json",
    "fixtures/github/review_threads_page_1.json",
    "fixtures/github/review_threads_page_2.json",
    "fixtures/github/review_thread_comments_page_2.json",
    "fixtures/github/review_threads_partial_error.json",
    "fixtures/github/cluster_graph.json",
    "fixtures/scenarios/observation_ordering.json",
    "fixtures/scenarios/interrupted_run.json",
    "fixtures/scenarios/review_membership.json"
  ],
  "scenarios": [
    {
      "id": "ordinary_issue_and_comments",
      "reference_tests": ["TestSyncReusesUnchangedIssueComments"],
      "invariants": ["comment_reuse"],
      "fixtures": ["fixtures/github/repository.json", "fixtures/github/issue.json", "fixtures/github/comments_complete.json"],
      "expected": "A completed comment snapshot is available for offline discussion reads."
    },
    {
      "id": "complete_empty_comments_are_distinct_from_missing",
      "reference_tests": ["TestSyncCommentReuseEmptyAndDeletedMembership"],
      "invariants": ["partial_sync_retains_work"],
      "fixtures": ["fixtures/github/comments_complete_empty.json"],
      "expected": "A successful empty list is complete empty membership; a failed or partial list is incomplete."
    },
    {
      "id": "partial_rest_pagination_and_rate_limit",
      "reference_tests": ["TestSyncPartialItemFailuresRetainHealthySiblingsAndRetry"],
      "invariants": ["partial_sync_retains_work", "failure_isolation"],
      "fixtures": ["fixtures/github/comments_page_1.json", "fixtures/github/comments_page_2.json", "fixtures/github/rate_limit_429.json"],
      "expected": "Keep committed page and sibling work, retain incomplete coverage, then retry idempotently."
    },
    {
      "id": "pull_request_metadata_and_reviews",
      "reference_tests": ["TestSyncPartialItemFailuresRetainHealthySiblingsAndRetry"],
      "invariants": ["failure_isolation"],
      "fixtures": ["fixtures/github/pull_request.json", "fixtures/github/pull_reviews.json"],
      "expected": "Keep base/head metadata and review evidence in independently covered families."
    },
    {
      "id": "nested_review_thread_pagination_and_partial_graphql_error",
      "reference_tests": ["TestProviderIDsGraphQLPagination", "TestGraphQLReviewThreadHistoryNestedPaginationAndRejection"],
      "invariants": ["review_membership_restore"],
      "fixtures": ["fixtures/github/review_threads_page_1.json", "fixtures/github/review_threads_page_2.json", "fixtures/github/review_thread_comments_page_2.json", "fixtures/github/review_threads_partial_error.json"],
      "expected": "Complete both outer and nested connections; GraphQL errors or a remaining cursor keep the observation incomplete."
    },
    {
      "id": "review_thread_membership_restore_and_rollback",
      "reference_tests": ["TestPullRequestReviewThreadMergeTombstoneRevisionAndRestore", "TestUpsertPullRequestReviewThreadsRollsBackMergeOnInsertError"],
      "invariants": ["review_membership_restore"],
      "fixtures": ["fixtures/scenarios/review_membership.json"],
      "expected": "An incomplete refresh cannot remove unseen members; explicit source deletion and restoration update current visibility atomically."
    },
    {
      "id": "delayed_observations_and_incomplete_generations",
      "reference_tests": ["TestCompareObservationOrder", "TestCompareRevisionObservationOrder", "TestUpsertThreadObservationTracksIncompleteEvidenceGeneration", "TestUpsertThreadObservationCompletesNewerSourceBelowEvidenceSequence"],
      "invariants": ["delayed_observations"],
      "fixtures": ["fixtures/scenarios/observation_ordering.json"],
      "expected": "Source time, acquisition sequence, and completeness remain separate and delayed observations cannot replace newer accepted state."
    },
    {
      "id": "isolated_item_failure_and_interrupted_run",
      "reference_tests": ["TestSyncPartialItemFailuresRetainHealthySiblingsAndRetry", "TestSyncCancellationRetainsOnlyCommittedItems", "TestSyncFailureResolutionRequiresObservedFamilies"],
      "invariants": ["failure_isolation", "partial_sync_retains_work"],
      "fixtures": ["fixtures/scenarios/interrupted_run.json"],
      "expected": "Committed siblings survive; pending families remain retryable; the run does not certify repository-wide coverage."
    },
    {
      "id": "closed_sweep_covers_offline_interval",
      "reference_tests": ["TestDefaultClosedSweepPreservesOfflineCoverageAndFailureCheckpoint"],
      "invariants": ["closed_sweep_offline_coverage"],
      "fixtures": ["fixtures/github/issue.json"],
      "expected": "Sweep from the previous watermark with overlap; a partial sweep does not advance the checkpoint or infer state from omission."
    },
    {
      "id": "unchanged_comments_reuse_completed_membership",
      "reference_tests": ["TestSyncReusesUnchangedIssueComments", "TestSyncCommentReuseInvalidation", "TestSyncCommentReuseEmptyAndDeletedMembership"],
      "invariants": ["comment_reuse"],
      "fixtures": ["fixtures/github/issue.json", "fixtures/github/comments_complete.json", "fixtures/github/comments_complete_empty.json"],
      "expected": "Reuse only a complete, present membership whose source timestamp and comment count remain valid; force or invalidation refreshes it."
    },
    {
      "id": "cluster_edge_scoring_is_stable",
      "reference_tests": ["TestPreparedClusterEdgesMatchOriginal"],
      "invariants": ["deterministic_cluster_scoring"],
      "fixtures": ["fixtures/github/cluster_graph.json"],
      "expected": "The same normalized vectors, titles, kinds, and thresholds yield the same eligible edge set and scores."
    }
  ]
}
